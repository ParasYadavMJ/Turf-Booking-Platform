rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'parasyadavmj@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['user', 'admin'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'turfId', 'turfName', 'sport', 'startTime', 'endTime', 'totalPrice', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.turfId is string &&
             data.sport is string &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.status in ['confirmed', 'cancelled'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    // Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; 
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /turfs/{turfId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status == 'cancelled';
    }
  }
}
